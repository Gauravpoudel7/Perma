{
  "name": "perma",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test:adapter": "anchor test --skip-local-validator -- --grep adapter",
    "test:unit": "cargo test -p perma --lib",
    "indexer:dev": "node --disable-warning=ExperimentalWarning indexer/src/server.ts",
    "indexer:ingest": "node --disable-warning=ExperimentalWarning indexer/src/ingest.ts",
    "indexer:test": "cd indexer && node --disable-warning=ExperimentalWarning --test",
    "lint": "cargo fmt --check && cargo clippy -- -D warnings",
    "reconcile": "node scripts/reconcile.mjs",
    "monitor": "node scripts/reconcile.mjs --monitor",
    "init-market": "node scripts/init-devnet-market.mjs",
    "upgrade-devnet-p3": "node scripts/upgrade-devnet-p3.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.0",
    "@solana/spl-token": "^0.4.9"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.2"
  }
}
