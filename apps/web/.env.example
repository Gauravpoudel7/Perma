# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_CLUSTER=localnet
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_PERMA_PROGRAM_ID=4qhBfpjfLUSgaSBNEM9aBQw9FbN2QysqLUgkUtM6HDdt
NEXT_PUBLIC_WHIRLPOOL=2WUgXbAmhquXMLhqqUthztDaVYnG8Mmp57CkXNb5ym9G

# Optional. Unset means no indexer: Markets falls back to live RPC reads,
# Portfolio shows no History section, and no chart renders. Never a source of
# truth for balances — those are always re-read over RPC before a transaction.
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8787/v1

# Localnet only. The public address `scripts/make-fixtures.mjs` funded with WSOL
# and Orca devUSDC. Written by `yarn sync-fixture-wallet`; the UI uses it to warn
# when a different wallet is connected, since devUSDC cannot be minted locally.
NEXT_PUBLIC_LOCALNET_FUNDED_WALLET=

# Optional. Pyth SOL/USD PriceUpdateV2 passed on mint when the program is P3
# (ADR-0004). Unset on localnet means the mock feed; keep it fresh with
# `node scripts/mock-price.mjs --loop` from the repo root, or mints fail OracleStale.
# Unset on Solana-devnet means the sponsored SOL/USD feed
# 7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE. Do not point devnet at the mock.
# NEXT_PUBLIC_PRICE_UPDATE=2SicEErwKeJkYv3ZUL35axMrGxqeKKUqsq3K7UH88Jrf
#
# Solana-devnet's live program is still pre-P3 until the operator runs
# scripts/upgrade-devnet-p3.mjs --deploy (docs/audits/IMPL-P3-DEVNET-UPGRADE.md).
# Mint omits price_update whenever NEXT_PUBLIC_CLUSTER=devnet unless this is 1.
# After the upgrade, set it to 1. The client then posts a Full Pyth update
# (Hermes → post_update) when the sponsored account is older than 60 seconds.
# 0 forces the pre-P3 account list on any cluster, including localnet.
# NEXT_PUBLIC_MINT_EXPECTS_PRICE_UPDATE=1
#
# Hermes key for that post. Read by the Next server and by yarn smoke-devnet-p3.
# Not a NEXT_PUBLIC_ variable: it must not ship in the browser bundle.
# Public Hermes returns HTTP 401 without it. Never commit the value.
# PYTH_API_KEY=

# --- Public Solana-devnet (alternative to the localnet block above) ---
# Use these once PERMA is deployed to Solana-devnet and the market is
# initialized (scripts/init-devnet-market.mjs). Phantom must be set to Devnet.
# NEXT_PUBLIC_CLUSTER=devnet
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_PERMA_PROGRAM_ID=4qhBfpjfLUSgaSBNEM9aBQw9FbN2QysqLUgkUtM6HDdt
# NEXT_PUBLIC_WHIRLPOOL=2WUgXbAmhquXMLhqqUthztDaVYnG8Mmp57CkXNb5ym9G
#
# Leave NEXT_PUBLIC_INDEXER_URL unset unless an indexer is hosted against
# Solana-devnet: the chart pane then shows its empty state rather than guessing.
# Leave NEXT_PUBLIC_LOCALNET_FUNDED_WALLET unset — it is a localnet-only check.
#
# Flip these only after scripts/upgrade-devnet-p3.mjs shows the ELF is no
# longer 594752 bytes. Until then a devnet mint must omit price_update.
# NEXT_PUBLIC_MINT_EXPECTS_PRICE_UPDATE=1
# NEXT_PUBLIC_PRICE_UPDATE=7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE
# PYTH_API_KEY=
